{
    "settings_metadata": {
        "date_created": "2026-05-19",
        "date_updated": "2026-05-19",
        "author": "omegazyph",
        "description": "Global configuration settings for the master expense tracking and ingestion workspace"
    },
    "project_paths": {
        "relative_data_directory": "../data",
        "master_ledger_filename": "expenses organized.json",
        "compiled_csv_filename": "combined_rent_payments.csv"
    },
    "spreadsheet_parsing_rules": {
        "target_worksheet_name": "Sheet1",
        "exclusion_keywords": [
            "Western",
            "Date",
            "Total"
        ],
        "expected_columns": [
            "Due Date",
            "Amount Paid",
            "Amount Owed",
            "Remaining Balance",
            "Date Paid",
            "Notes"
        ]
    },
    "ingestion_flags": {
        "strict_file_enforcement": true,
        "calculate_financial_summary": true,
        "target_json_destination_key": "rent_payment_history_ledger"
    }
}