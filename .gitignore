###############################################################################
# Project    : GitHub Exclusions Configuration
# File Name  : .gitignore
# Author     : omegazyph
# Created    : 01-05-2026
# Updated    : 09-11-2026
# Description: Specifies intentionally untracked files and private local 
#              directories that Git should ignore when pushing to GitHub.
###############################################################################

# ==========================================
# CUSTOM & LOCAL EXCLUSIONS
# ==========================================
# Private local workspace folder
private/

# Ignore config files anywhere in the repository
**/config.json
**/config_copy.json
**/config/

# Logs and local data files
logs/
*.csv
*.log

# Environment files
.env
.venv/
env/
venv/
ENV/
*.bak/

# ==========================================
# IDE & EDITOR SETTINGS
# ==========================================
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject

# ==========================================
# PYTHON ARTIFACTS
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution & Packaging
build/
dist/
*.egg-info/
*.egg
*.spec

# Testing & Coverage
.cache/
.pytest_cache/
.coverage
htmlcov/

# Type Checking & Linting
.mypy_cache/
.ruff_cache/
pyrightconfig.json

# ==========================================
# SYSTEM & OS (WINDOWS)
# ==========================================
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk